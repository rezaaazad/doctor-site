# Copy to .env and replace every secret before the first boot.

POSTGRES_USER=doctor
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=doctor_site

# Used by local `npm run dev`. Compose overrides this inside the app container.
DATABASE_URL=postgresql://doctor:change-this-database-password@localhost:5432/doctor_site?schema=public

ADMIN_EMAIL=admin@doctor-site.ir
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=مدیر

# At least 32 characters. Rotating it signs everyone out.
SESSION_SECRET=replace-with-64-hex-characters

SITE_URL=https://doctor-site.ir
UPLOAD_DIR=/data/uploads

# Optional. Header set by the trusted CDN that carries the visitor IP (for rate limits, OTP and logs),
# for example x-real-ip. Empty = last X-Forwarded-For hop (the address Caddy saw).
CLIENT_IP_HEADER=

# Optional. Set to 0 to skip the fill-missing seed on boot (it never overwrites existing content).
SEED_ON_BOOT=

# Payment gateways, SMS (Kavenegar/Melipayamak), SMTP, Telegram, Torob and Snapp Shop credentials are
# configured in the admin panel (Settings), not here.

# Host ports. Use 80 and 443 on the server. Use a high port for a local preview.
HTTP_PORT=80
HTTPS_PORT=443
CADDY_EMAIL=admin@doctor-site.ir

# Production file obtains certificates for the domains.
# For an IP-only preview without Let's Encrypt, set CADDYFILE=./Caddyfile.preview
CADDYFILE=./Caddyfile

# Optional FARAZSMS_API_TOKEN fallback when the SMS settings API key is empty.
